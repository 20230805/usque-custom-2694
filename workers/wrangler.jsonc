{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "usque-masque-pro-v67",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-03",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
